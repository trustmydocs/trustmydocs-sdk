{
  "name": "trustmydocs",
  "version": "0.1.0",
  "description": "Vérification de documents officiels français (avis d'imposition, 2D-Doc, carte d'identité, bulletin de paie, dossier locataire) depuis Node.js, la ligne de commande ou un client MCP. SDK, CLI et serveur MCP de l'API Trust My Docs.",
  "keywords": [
    "2d-doc",
    "2ddoc",
    "avis-d-imposition",
    "avis-imposition",
    "verification-documents",
    "faux-documents",
    "dossier-locataire",
    "carte-identite",
    "bulletin-de-paie",
    "datamatrix",
    "dgfip",
    "ants",
    "document-verification",
    "tax-notice",
    "kyc",
    "france",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cli",
    "sdk"
  ],
  "homepage": "https://trustmydocs.com",
  "bugs": "https://github.com/trustmydocs/trustmydocs-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustmydocs/trustmydocs-sdk.git"
  },
  "license": "Apache-2.0",
  "author": "Trust My Docs <contact@trustmydocs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "trustmydocs": "dist/cli.js",
    "trustmydocs-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js dist/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:hygiene": "scripts/check-hygiene.sh",
    "prepublishOnly": "npm run check:hygiene && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.3"
  }
}
